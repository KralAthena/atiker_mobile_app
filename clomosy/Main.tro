void ProfilKapat;
{
  pnlProfil.Visible = False;
}

void BotCevap(ASoru: String);
var
  c: String;
  q: String;
{
  q = LowerCase(ASoru);
  c = 'KPI, uyari, analiz, rapor ve aksiyon sayfalarina alt menuden gecebilirsin.';
  if (Copy(q, 1, 3) == 'kpi')
    c = IntToStr(nToplam) + ' KPI tanimi var. Satis: ' + IntToStr(nSatis) + ', Finans: ' + IntToStr(nFinans) + '.';
  if (Copy(q, 1, 4) == 'uyar')
    c = IntToStr(nUyari) + ' uyari acik. Kritik: ' + IntToStr(nKritikUyari) + ', Risk: ' + IntToStr(nRiskUyari) + '.';
  if (Copy(q, 1, 5) == 'rapor')
    c = IntToStr(nRapor) + ' hazir rapor. Son baslik: ' + KisaMetin(GRaporBaslik, 42);
  if (Copy(q, 1, 4) == 'anal')
    c = 'Analiz notu: ' + KisaMetin(GYorum, 72);
  if (Copy(q, 1, 4) == 'merh')
    c = 'Merhaba ' + GUserName + '. DeltaKPI asistanindayim.';
  if (Copy(q, 1, 4) == 'yard')
    c = YardimMetni;
  if (Copy(q, 1, 5) == 'anoma')
    c = IntToStr(nAnomali) + ' anomali tespit edildi. Kritik uyari: ' + IntToStr(nKritikUyari) + '.';
  if (Copy(q, 1, 5) == 'tahmi')
    c = IntToStr(nTahmin) + ' guvenilir tahmin var. Toplam KPI: ' + IntToStr(nToplam) + '.';
  if (Copy(q, 1, 4) == 'durum')
    c = DurumOnerisi;
  if (Copy(q, 1, 4) == 'ayar')
    c = AyarlarMetni;
  if (Copy(q, 1, 4) == 'denet')
    c = DenetimMetni(AlanListesi(auditJson, '"action":"', 10), nDenetim);
  GBotMetin = GBotMetin + #13#10 + 'Sen: ' + ASoru + #13#10 + 'Bot: ' + c;
  memoSayfa.Lines.Text = GBotMetin;
}

void BotGonderTikla;
{
  if (Trim(edtBotMsg.Text) == '')
    ShowMessage('Bir soru yaz. Ornek: kpi, uyari, rapor')
  else
  {
    BotCevap(edtBotMsg.Text);
    edtBotMsg.Text = '';
  }
}

void BotGit;
{
  MenuKapat;
  pnlDashIcerik.Visible = False;
  lblDetayBaslik.Text = 'DeltaKPI Asistan';
  GBotMetin = 'Merhaba ' + GUserName + '.' + #13#10 +
              'Canli ozet sorulari sorabilirsin.' + #13#10 +
              'Ornek: kpi, uyari, rapor, analiz, durum, yardim';
  memoSayfa.Lines.Text = GBotMetin;
  pnlDetay.Visible = True;
  memoSayfa.Visible = True;
  btnGeriSayfa.Visible = True;
  edtBotMsg.Visible = True;
  btnBotGonder.Visible = True;
  clRTMethod(pnlDetay, 'BringTofront');
}

void CikisYap;
{
  MenuKapat;
  frmDash.clHide;
  frmLogin.clShow;
}

void AnaEkran;
{
  MenuKapat;
  ProfilKapat;
  pnlDetay.Visible = False;
  memoSayfa.Visible = False;
  btnGeriSayfa.Visible = False;
  edtBotMsg.Visible = False;
  btnBotGonder.Visible = False;
  AltNavGuncelle('GENEL');
  pnlDashIcerik.Visible = True;
  BannerOzetGuncelle;
  DurumGuncelle;
  MenuOzetGuncelle;
  DashUsteDon;
}

void SayfaGoster(ABaslik, AMetin: String);
{
  MenuKapat;
  ProfilKapat;
  pnlDashIcerik.Visible = False;
  lblDetayBaslik.Text = ABaslik;
  memoSayfa.Lines.Text = '  ' + AMetin;
  pnlDetay.Visible = True;
  memoSayfa.Visible = True;
  btnGeriSayfa.Visible = True;
  edtBotMsg.Visible = False;
  btnBotGonder.Visible = False;
  clRTMethod(pnlDetay, 'BringTofront');
}

void GenelBakis;
var
  metin: String;
{
  AltNavGuncelle('GENEL');
  metin = GenelBakisMetni(GYorum, GRaporBaslik, nToplam, nUyari, nKayit, nAksiyon, nRapor);
  SayfaGoster('Genel bakış', metin);
}

void KpiGit;
var
  metin: String;
{
  if (RolKpiGorebilir == 0)
    GenelBakis
  else
  {
  AltNavGuncelle('KPI');
  metin = AlanListesi(kpiJson, '"name":"', 8);
  if (metin == '')
    metin = 'Canlı KPI tanımı yok.';
  SayfaGoster('KPI yönetimi', KpiYonetimiMetni(metin, nSatis, nFinans, nOperasyon, nIk, nPazarlama, nUretim, nMusteri));
  }
}

