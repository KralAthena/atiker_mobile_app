void GirisTikla;
{
  mail = Trim(edtEmail.Text);
  sifre = Trim(edtSifre.Text);
  if (Copy(GAuthLoginUrl, 1, 4) <> 'http')
    ShowMessage('Firebase ayarı eksik. Main.tro içindeki yerel ayarları doldurun.')
  else if (MailOk(mail) == 0)
    ShowMessage('E-posta okunamadı.')
  else
  {
    body = '{"email":"' + mail + '","password":"' + sifre + '","returnSecureToken":true}';
    HttpRest = TclRest.Create;
    HttpRest.Accept = 'application/json';
    HttpRest.ContentType = 'application/json';
    HttpRest.ConnectTimeOut = 60000;
    HttpRest.BaseURL = GAuthLoginUrl;
    HttpRest.Method = rmPOST;
    HttpRest.AddBody(body, 'application/json');
    HttpRest.Execute;
    cevap = HttpRest.Response;
    GIdToken = Clomosy.CLParseJSON(cevap, 'idToken');
    GUid = Clomosy.CLParseJSON(cevap, 'localId');
    if (GIdToken == '')
      ShowMessage('Giriş olmadı.')
    else
    {
      profil = RtdbGet('users/' + GUid);
      GCompanyId = Clomosy.CLParseJSON(profil, 'companyId');
      GUserRole = Clomosy.CLParseJSON(profil, 'role');
      GUserName = Clomosy.CLParseJSON(profil, 'firstName');
      DashboardAc;
    }
  }
}

{
  GAuthLoginUrl = 'FIREBASE_AUTH_LOGIN_URL';
  GRtdbUrl = 'FIREBASE_RTDB_URL';
  GIdToken = '';

  frmLogin = TclForm.Create(Self);
  frmLogin.SetFormColor('#faf4e4', '#f0e2c0', clGVertical);
  frmLogin.clSetCaption('DeltaKPI');
