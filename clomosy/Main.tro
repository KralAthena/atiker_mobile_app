function MailOk(AMail: String): Integer;
var
  i: Integer;
{
  Result = 0;
  i = 1;
  while (i <= 80)
  {
    if (Copy(AMail, i, 1) == '@')
      Result = 1;
    i = i + 1;
  }
}

function MetinSay(AMetin, AKalip: String; AUzun: Integer): Integer;
var
  n: Integer;
  i: Integer;
{
  n = 0;
  i = 1;
  while (i <= 2500)
  {
    if (Copy(AMetin, i, AUzun) == AKalip)
      n = n + 1;
    i = i + 1;
  }
  Result = n;
}

function IlkAlan(AJson, AKalip: String; AUzun: Integer): String;
var
  i: Integer;
  j: Integer;
  ch: String;
  isim: String;
{
  Result = '';
  i = 1;
  while (i <= 2500)
  {
    if (Copy(AJson, i, AUzun) == AKalip)
    {
      if (Result == '')
      {
        isim = '';
        j = 1;
        while (j <= 80)
        {
          ch = Copy(AJson, i + AUzun + j - 1, 1);
          if (ch == '"')
            j = 81
          else
            isim = isim + ch;
          j = j + 1;
        }
        Result = isim;
      }
    }
    i = i + 1;
  }
}

function KisaMetin(AMetin: String; AUzun: Integer): String;
{
  Result = AMetin;
  if (Copy(AMetin, AUzun + 1, 1) <> '')
    Result = Copy(AMetin, 1, AUzun) + '...';
}

function AlanListesi(AJson, AKalip: String; AUzun: Integer): String;
var
  i: Integer;
  j: Integer;
  ch: String;
  isim: String;
  sonuc: String;
{
  sonuc = '';
  i = 1;
  while (i <= 2500)
  {
    if (Copy(AJson, i, AUzun) == AKalip)
    {
      isim = '';
      j = 1;
      while (j <= 140)
      {
        ch = Copy(AJson, i + AUzun + j - 1, 1);
        if (ch == '"')
          j = 141
        else
          isim = isim + ch;
        j = j + 1;
      }
      if (sonuc == '')
        sonuc = '- ' + isim
      else
        sonuc = sonuc + #13#10 + '- ' + isim;
      i = i + AUzun;
    }
    i = i + 1;
  }
  Result = sonuc;
}

function RtdbGet(AYol: String): String;
{
  HttpRest = TclRest.Create;
  HttpRest.Accept = 'application/json';
  HttpRest.BaseURL = GRtdbUrl + '/' + AYol + '.json?auth=' + GIdToken;
  HttpRest.Method = rmGET;
  HttpRest.Execute;
  Result = HttpRest.Response;
}

void CanliVeriYukle;
var
  firma: String;
{
  nSatis = 0;
  nFinans = 0;
  nOperasyon = 0;
  nIk = 0;
  nPazarlama = 0;
  nUretim = 0;
  nMusteri = 0;
  nToplam = 0;
  nUyari = 0;
  nKayit = 0;
  nAksiyon = 0;
  nRapor = 0;
  nKritikUyari = 0;
  nRiskUyari = 0;
  nInfoUyari = 0;
  nAnomali = 0;
  nTahmin = 0;
  nDenetim = 0;
  GYorum = '';
  GRaporBaslik = '';
  firma = RtdbGet('companies/' + GCompanyId);
  GCompanyName = Clomosy.CLParseJSON(firma, 'name');
  if (GCompanyName == '')
    GCompanyName = GCompanyId;
  kpiJson = RtdbGet('kpiDefinitions/' + GCompanyId);
  alertJson = RtdbGet('alerts/' + GCompanyId);
  entryJson = RtdbGet('kpiEntries/' + GCompanyId);
  analizJson = RtdbGet('analysisResults/' + GCompanyId);
  actionJson = RtdbGet('actionPlans/' + GCompanyId);
  reportJson = RtdbGet('aiReports/' + GCompanyId);
  anomalyJson = RtdbGet('anomalies/' + GCompanyId);
  auditJson = RtdbGet('auditLogs/' + GCompanyId);
  nSatis = MetinSay(kpiJson, '"category":"sales"', 18);
  nFinans = MetinSay(kpiJson, '"category":"finance"', 20);
  nOperasyon = MetinSay(kpiJson, '"category":"operations"', 23);
  nIk = MetinSay(kpiJson, '"category":"hr"', 15);
  nPazarlama = MetinSay(kpiJson, '"category":"marketing"', 22);
  nUretim = MetinSay(kpiJson, '"category":"production"', 23);
  nMusteri = MetinSay(kpiJson, '"category":"customer"', 21);
  nToplam = nSatis + nFinans + nOperasyon + nIk + nPazarlama + nUretim + nMusteri;
  nUyari = MetinSay(alertJson, '"title":"', 9);
  nKayit = MetinSay(entryJson, '"period":"', 10);
  nAksiyon = MetinSay(actionJson, '"title":"', 9);
  nRapor = MetinSay(reportJson, '"title":"', 9);
  nKritikUyari = MetinSay(alertJson, '"severity":"critical"', 21);
  nRiskUyari = MetinSay(alertJson, '"severity":"risk"', 17) + MetinSay(alertJson, '"severity":"warning"', 20);
  nInfoUyari = MetinSay(alertJson, '"severity":"info"', 17) + MetinSay(alertJson, '"severity":"success"', 20);
  nAnomali = MetinSay(anomalyJson, '"description":"', 15);
  nTahmin = MetinSay(analizJson, '"forecastReliable":true', 21);
  if (nTahmin == 0)
    nTahmin = MetinSay(analizJson, '"forecastValue":', 16);
  nDenetim = MetinSay(auditJson, '"action":"', 10);
  GYorum = IlkAlan(analizJson, '"executiveComment":"', 21);
  GRaporBaslik = IlkAlan(reportJson, '"title":"', 9);
  if (GYorum == '')
    GYorum = 'Bugün için canlı analiz notu bulunmuyor. KPI verisi arttıkça bu alan yönetsel yorumlarla dolacak.';
  if (GRaporBaslik == '')
    GRaporBaslik = 'Hazır rapor henüz oluşmadı.';
}

void BarGizle(AForm: TclForm);
{
  try
    TclButton(AForm.clFindComponent('BtnGoBack')).Visible = False;
    TclButton(AForm.clFindComponent('BtnFormMenu')).Visible = False;
  except
    LastHttpCode = 0;
  }
}

void AltinBtn(ABtn: TclProButton);
{
  ABtn.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#c98a1b');
  ABtn.clProSettings.FontColor = clAlphaColor.clHexToColor('#faf4e4');
  ABtn.clProSettings.FontSize = 15;
  ABtn.clProSettings.FontHorzAlign = palCenter;
  ABtn.clProSettings.FontVertAlign = palcenter;
  ABtn.clProSettings.TextSettings.Font.Style = [fsBold];
  ABtn.clProSettings.IsRound = True;
  ABtn.clProSettings.RoundHeight = 14;
  ABtn.clProSettings.RoundWidth = 14;
  ABtn.clProSettings.IsFill = True;
  ABtn.clProSettings.BorderWidth = 0;
  ABtn.SetclProSettings(ABtn.clProSettings);
}

