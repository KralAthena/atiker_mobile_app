void AltNavGuncelle(ASecim: String);
{
  AltNavPasif(btnTabGenel);
  AltNavPasif(btnTabKpi);
  AltNavPasif(btnTabAnaliz);
  AltNavPasif(btnTabUyari);
  AltNavPasif(btnTabAksiyon);
  AltNavPasif(btnTabRapor);

  if (ASecim == 'GENEL')
    AltNavSecili(btnTabGenel);
  if (ASecim == 'KPI')
    AltNavSecili(btnTabKpi);
  if (ASecim == 'ANALIZ')
    AltNavSecili(btnTabAnaliz);
  if (ASecim == 'UYARI')
    AltNavSecili(btnTabUyari);
  if (ASecim == 'AKSIYON')
    AltNavSecili(btnTabAksiyon);
  if (ASecim == 'RAPOR')
    AltNavSecili(btnTabRapor);
}

