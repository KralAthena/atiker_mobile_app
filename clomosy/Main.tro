void BannerOzetGuncelle;
{
  lblBannerOzet.Text = 'Canlı panel özeti';
  lblBannerOzetAlt.Text = IntToStr(nToplam) + ' KPI  |  ' + IntToStr(nUyari) + ' uyarı  |  ' + IntToStr(nAnomali) + ' anomali';
  btnHeroKpi.Text = 'KPI' + #13#10 + IntToStr(nToplam);
  btnHeroRisk.Text = 'Risk' + #13#10 + IntToStr(nRiskUyari + nKritikUyari);
  btnHeroKritik.Text = 'Kritik' + #13#10 + IntToStr(nKritikUyari);
}

void DurumGuncelle;
{
  lblDurumAciklama.Text = DurumOnerisi;
  if (nKritikUyari > 0)
  {
    lblDurumChip.Text = 'KRITIK';
    lblDurumChip.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#ffe8e8');
    lblDurumChip.clProSettings.FontColor = clAlphaColor.clHexToColor('#8b1a1a');
  }
  else
  {
    if (nAnomali > 0)
    {
      lblDurumChip.Text = 'DIKKAT';
      lblDurumChip.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#fff2cc');
      lblDurumChip.clProSettings.FontColor = clAlphaColor.clHexToColor('#b36a00');
    }
    else
    {
      if (nRiskUyari > 0)
      {
        lblDurumChip.Text = 'DIKKAT';
        lblDurumChip.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#fff2cc');
        lblDurumChip.clProSettings.FontColor = clAlphaColor.clHexToColor('#b36a00');
      }
      else
      {
        lblDurumChip.Text = 'STABIL';
        lblDurumChip.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#e8f5e9');
        lblDurumChip.clProSettings.FontColor = clAlphaColor.clHexToColor('#2e7d32');
      }
    }
  }
  lblDurumChip.clProSettings.TextSettings.Font.Style = [fsBold];
  lblDurumChip.clProSettings.FontHorzAlign = palCenter;
  lblDurumChip.clProSettings.FontVertAlign = palcenter;
  lblDurumChip.SetclProSettings(lblDurumChip.clProSettings);
}

void MenuOzetGuncelle;
{
  lblMenuFirma.Text = GCompanyName;
  lblMenuCanli.Text = IntToStr(nUyari) + ' uyarı  |  ' + IntToStr(nAnomali) + ' anomali  |  ' + IntToStr(nRapor) + ' rapor';
  lblWebNot.Text = 'Web panel: analiz çalıştır, AI rapor üret, CSV/PDF dışa aktar. Mobilde canlı özet ve takip.';
}

void ZilYaziGuncelle;
{
  if (nUyari > 0)
  {
    btnZil.Text = '🔔' + #13#10 + IntToStr(nUyari);
    btnZil.clProSettings.FontSize = 11;
  }
  else
  {
    btnZil.Text = '🔔';
    btnZil.clProSettings.FontSize = 18;
  }
  btnZil.SetclProSettings(btnZil.clProSettings);
}

void SonAktiviteGuncelle;
{
  lblSonAktivite.Text = SonAktiviteMetni;
}

void DashUsteDon;
{
  try
    clRTMethod(lblMerhaba, 'SetFocus');
  except
    LastHttpCode = 0;
  }
}

void DashGuncelle;
{
  CanliVeriYukle;
  lblMerhaba.Text = 'Merhaba ' + GUserName;
  lblFirma.Text = GCompanyName + '  |  ' + GUserRole;
  lblMenuUser.Text = GUserName;
  lblYorum.Text = GYorum;
  lblYorumAlt.Text = 'Son rapor: ' + GRaporBaslik;
  lblYorumMeta.Text = 'Anomali: ' + IntToStr(nAnomali) + '  |  Tahmin: ' + IntToStr(nTahmin) + '  |  Rapor: ' + IntToStr(nRapor);
  lblKartKpiV.Text = IntToStr(nToplam);
  lblKartUyariV.Text = IntToStr(nUyari);
  lblKartKayitV.Text = IntToStr(nKayit);
  lblKartAksiyonV.Text = IntToStr(nAksiyon);
  lblKartRaporV.Text = IntToStr(nRapor);
  ChartDoldurEx(chartKpi, nSatis, nFinans, nOperasyon, nIk, nPazarlama, nUretim, nMusteri);
  PanelOzetChartDoldurEx(chartPanelOzet, nToplam, nUyari, nKayit);
  UyariChartDoldurEx(chartUyari, nKritikUyari, nRiskUyari, nInfoUyari);
  AnomaliChartDoldurEx(chartAnomali, nAnomali, nTahmin, nUyari);
  BannerOzetGuncelle;
  DurumGuncelle;
  SonAktiviteGuncelle;
  MenuOzetGuncelle;
  ZilYaziGuncelle;
}

