void MemoAyar(AMemo: TcProMemo);
{
  AMemo.Margins.Left = 24;
  AMemo.Margins.Right = 20;
  AMemo.Margins.Top = 16;
  AMemo.Margins.Bottom = 14;
  AMemo.ReadOnly = True;
  try
    AMemo.clProSettings.FontColor = clAlphaColor.clHexToColor('#2a2210');
    AMemo.clProSettings.FontSize = 13;
    AMemo.clProSettings.WordWrap = True;
    AMemo.SetclProSettings(AMemo.clProSettings);
  except
    LastHttpCode = 0;
  }
}

void MetrikKartEkle(AParent: TclFlowLayout; AName, ABaslik, ADeger, AGitEvent: String);
var
  kart: TclProPanel;
  lblT: TclProLabel;
  lblV: TclProLabel;
{
  kart = frmDash.AddNewProPanel(AParent, AName);
  kart.Width = 158;
  kart.Height = 96;
  kart.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#ffffff');
  kart.clProSettings.BorderColor = clAlphaColor.clHexToColor('#e8d5a8');
  kart.clProSettings.BorderWidth = 1;
  kart.clProSettings.IsFill = True;
  kart.clProSettings.IsRound = True;
  kart.clProSettings.RoundHeight = 14;
  kart.clProSettings.RoundWidth = 14;
  kart.SetclProSettings(kart.clProSettings);
  if (AGitEvent <> '')
    frmDash.AddNewEvent(kart, tbeOnClick, AGitEvent);

  lblT = frmDash.AddNewProLabel(kart, AName + 'T', ABaslik);
  lblT.Align = alMostTop;
  lblT.Height = 28;
  lblT.Margins.Left = 12;
  lblT.Margins.Right = 8;
  lblT.Margins.Top = 10;
  YaziAyar(lblT, '#6b5a2e', 11);

  lblV = frmDash.AddNewProLabel(kart, AName + 'V', ADeger);
  lblV.Align = alClient;
  lblV.Margins.Left = 12;
  lblV.Margins.Right = 8;
  lblV.Margins.Bottom = 10;
  YaziAyar(lblV, '#2a2210', 28);
  lblV.clProSettings.TextSettings.Font.Style = [fsBold];
  lblV.clProSettings.FontVertAlign = palcenter;
  lblV.SetclProSettings(lblV.clProSettings);

  if (AName == 'kartKpi')
    lblKartKpiV = lblV;
  if (AName == 'kartUyari')
    lblKartUyariV = lblV;
  if (AName == 'kartKayit')
    lblKartKayitV = lblV;
  if (AName == 'kartAksiyon')
    lblKartAksiyonV = lblV;
  if (AName == 'kartRapor')
    lblKartRaporV = lblV;
}

void ChartDoldurEx(AChart: TclChart; ANSatis, ANFinans, ANOperasyon, ANIk, ANPazarlama, ANUretim, ANMusteri: Integer);
var
  chartJsonEx: String;
{
  chartJsonEx = '[';
  if (ANSatis > 0)
    chartJsonEx = chartJsonEx + '{"Ad":"Satis","Adet":' + IntToStr(ANSatis) + ',"color":"clGold"}';
  if (ANFinans > 0)
  {
    if (chartJsonEx <> '[')
      chartJsonEx = chartJsonEx + ',';
    chartJsonEx = chartJsonEx + '{"Ad":"Finans","Adet":' + IntToStr(ANFinans) + ',"color":"clOrange"}';
  }
  if (ANOperasyon > 0)
  {
    if (chartJsonEx <> '[')
      chartJsonEx = chartJsonEx + ',';
    chartJsonEx = chartJsonEx + '{"Ad":"Operasyon","Adet":' + IntToStr(ANOperasyon) + ',"color":"clPeru"}';
  }
  if (ANIk > 0)
  {
    if (chartJsonEx <> '[')
      chartJsonEx = chartJsonEx + ',';
    chartJsonEx = chartJsonEx + '{"Ad":"IK","Adet":' + IntToStr(ANIk) + ',"color":"clTomato"}';
  }
  if (ANPazarlama > 0)
  {
    if (chartJsonEx <> '[')
      chartJsonEx = chartJsonEx + ',';
    chartJsonEx = chartJsonEx + '{"Ad":"Pazarlama","Adet":' + IntToStr(ANPazarlama) + ',"color":"clYellowGreen"}';
  }
  if (ANUretim > 0)
  {
    if (chartJsonEx <> '[')
      chartJsonEx = chartJsonEx + ',';
    chartJsonEx = chartJsonEx + '{"Ad":"Uretim","Adet":' + IntToStr(ANUretim) + ',"color":"clPurple"}';
  }
  if (ANMusteri > 0)
  {
    if (chartJsonEx <> '[')
      chartJsonEx = chartJsonEx + ',';
    chartJsonEx = chartJsonEx + '{"Ad":"Musteri","Adet":' + IntToStr(ANMusteri) + ',"color":"clPink"}';
  }
  chartJsonEx = chartJsonEx + ']';
  if (chartJsonEx == '[]')
    chartJsonEx = '[{"Ad":"KPI yok","Adet":0,"color":"clGold"}]';
  AChart.Charttype = clCBar;
  AChart.XAxisText = 'Ad';
  AChart.ChartItemText = 'KPI';
  AChart.ChartItemsValue = 'Adet';
  AChart.ChartTitle = 'KPI dağılımı';
  AChart.clLoadDataFromJSONStr(chartJsonEx);
}

void PanelOzetChartDoldurEx(AChart: TclChart; ANToplam, ANUyari, ANKayit: Integer);
var
  j: String;
{
  j = '[';
  j = j + '{"Ad":"KPI","Adet":' + IntToStr(ANToplam) + ',"color":"clGold"},';
  j = j + '{"Ad":"Uyari","Adet":' + IntToStr(ANUyari) + ',"color":"clTomato"},';
  j = j + '{"Ad":"Kayit","Adet":' + IntToStr(ANKayit) + ',"color":"clSkyBlue"}]';
  AChart.Charttype = clCBar;
  AChart.XAxisText = 'Ad';
  AChart.ChartItemText = 'Panel';
  AChart.ChartItemsValue = 'Adet';
  AChart.ChartTitle = 'Panel özeti';
  AChart.clLoadDataFromJSONStr(j);
}

void UyariChartDoldurEx(AChart: TclChart; ANKritik, ANRisk, ANInfo: Integer);
var
  j: String;
{
  j = '[';
  if (ANKritik > 0)
    j = j + '{"Ad":"Kritik","Adet":' + IntToStr(ANKritik) + ',"color":"clTomato"}';
  if (ANRisk > 0)
  {
    if (j <> '[')
      j = j + ',';
    j = j + '{"Ad":"Risk","Adet":' + IntToStr(ANRisk) + ',"color":"clOrange"}';
  }
  if (ANInfo > 0)
  {
    if (j <> '[')
      j = j + ',';
    j = j + '{"Ad":"Bilgi","Adet":' + IntToStr(ANInfo) + ',"color":"clSkyBlue"}';
  }
  if (j == '[')
    j = '[{"Ad":"Kritik","Adet":0,"color":"clTomato"},{"Ad":"Risk","Adet":0,"color":"clOrange"},{"Ad":"Bilgi","Adet":0,"color":"clSkyBlue"}]'
  else
    j = j + ']';
  AChart.Charttype = clCBar;
  AChart.XAxisText = 'Ad';
  AChart.ChartItemText = 'Uyarı';
  AChart.ChartItemsValue = 'Adet';
  AChart.ChartTitle = 'Uyarı dağılımı';
  AChart.clLoadDataFromJSONStr(j);
}

void AnomaliChartDoldurEx(AChart: TclChart; ANAnomali, ANTahmin, ANUyari: Integer);
var
  j: String;
{
  j = '[';
  j = j + '{"Ad":"Anomali","Adet":' + IntToStr(ANAnomali) + ',"color":"clTomato"},';
  j = j + '{"Ad":"Tahmin","Adet":' + IntToStr(ANTahmin) + ',"color":"clOrange"},';
  j = j + '{"Ad":"Uyari","Adet":' + IntToStr(ANUyari) + ',"color":"clGold"}]';
  AChart.Charttype = clCBar;
  AChart.XAxisText = 'Ad';
  AChart.ChartItemText = 'Risk';
  AChart.ChartItemsValue = 'Adet';
  AChart.ChartTitle = 'Risk görünümü';
  AChart.clLoadDataFromJSONStr(j);
}

function SonAktiviteMetni: String;
var
  uyari: String;
  denetim: String;
  aksiyon: String;
{
  uyari = AlanListesi(alertJson, '"title":"', 9);
  denetim = AlanListesi(auditJson, '"action":"', 10);
  aksiyon = AlanListesi(actionJson, '"title":"', 9);
  if (uyari == '')
    uyari = '- Açık uyarı yok';
  if (denetim == '')
    denetim = '- İşlem kaydı yok';
  if (aksiyon == '')
    aksiyon = '- Açık aksiyon yok';
  Result = 'Uyarı akışı' + #13#10 + uyari + #13#10 + #13#10 +
           'Aksiyonlar' + #13#10 + aksiyon + #13#10 + #13#10 +
           'İşlem geçmişi' + #13#10 + denetim;
}

function DurumOnerisi: String;
{
  Result = 'Panel dengeli görünüyor. KPI, veri ve rapor akışını izlemeye devam et.';
  if (nKritikUyari > 0)
    Result = IntToStr(nKritikUyari) + ' kritik uyarı var. Önce uyarı ve aksiyon planlarını kapat.';
  if (nKritikUyari == 0)
  {
    if (nAnomali > 0)
      Result = IntToStr(nAnomali) + ' anomali tespit edildi. Analiz ve tahmin merkezini kontrol et.';
    if (nAnomali == 0)
    {
      if (nRiskUyari > 0)
        Result = IntToStr(nRiskUyari) + ' risk seviyesinde uyarı var. KPI sapmalarını takip et.';
    }
  }
}

function GenelBakisMetni(AGYorum, ARaporBaslik: String; ANToplam, ANUyari, ANKayit, ANAksiyon, ANRapor: Integer): String;
{
  Result = 'Özet' + #13#10 + #13#10 +
           '- KPI: ' + IntToStr(ANToplam) + #13#10 +
           '- Uyarı: ' + IntToStr(ANUyari) + #13#10 +
           '- Kayıt: ' + IntToStr(ANKayit) + #13#10 +
           '- Aksiyon: ' + IntToStr(ANAksiyon) + #13#10 +
           '- Rapor: ' + IntToStr(ANRapor) + #13#10 +
           '- Anomali: ' + IntToStr(nAnomali) + #13#10 +
           '- Tahmin: ' + IntToStr(nTahmin) + #13#10 + #13#10 +
           'Not' + #13#10 + #13#10 + AGYorum + #13#10 + #13#10 +
           'Rapor' + #13#10 + #13#10 + ARaporBaslik + #13#10 + #13#10 +
           'Odak' + #13#10 + #13#10 +
           'Satış, uyarı, aksiyon ve AI rapor akışını tek panelden izle.';
}

